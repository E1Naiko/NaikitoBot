# Required
DISCORD_TOKEN=replace_with_your_bot_token
ADMIN_USER_IDS=123456789012345678
GUILD_ID=123456789012345678
GENERAL_CHANNEL_ID=123456789012345678
MADRUGUE_CHANNEL_ID=123456789012345678

# Channels: comma-separated Discord channel IDs
BOX_CHANNEL_ID=123456789012345678
SSF_CANALES_ID=123456789012345678

# Runtime and database
TIMEZONE=America/Argentina/Buenos_Aires
DATABASE=naikito.db

# SeptSinFP dates
SSF_FECHA_INICIO=2026-09-01
SSF_FECHA_FIN=2026-09-30

# Madrugue scoring: HH:MM windows, integer points, decimal bonus
MADRUGUE_INICIO_100=05:30
MADRUGUE_INICIO_25=07:00
MADRUGUE_INICIO_5=09:00
MADRUGUE_FIN=10:00
MADRUGUE_PUNTOS_100=100
MADRUGUE_PUNTOS_25=25
MADRUGUE_PUNTOS_5=5
MADRUGUE_BONUS_MAXIMO=0.100
MADRUGUE_BONUS_MINIMO=0.001

# ============================================================
# BOX
# ============================================================

# Rewards per minute of each action
BOX_EXPERIENCIA_POR_MINUTO=10
BOX_DINERO_POR_MINUTO=100

# Action duration limits, in minutes
BOX_MINUTOS_MINIMO=1
BOX_MINUTOS_MAXIMO=1440

# Fixed gain per level of each upgrade (Creatina / Cafe)
BOX_MEJORA_ENTRENAMIENTO_EXP_POR_NIVEL=5
BOX_MEJORA_TRABAJO_DINERO_POR_NIVEL=50
BOX_MEJORA_NIVEL_MAXIMO=10

# Shop: global price multiplier (applies to every item) and
# per-level growth (upgrades compound, equipment multiplies)
BOX_PRECIO_MULTIPLICADOR=1.0
BOX_PRECIO_MEJORA_CRECIMIENTO=1.25
BOX_PRECIO_EQUIPAMIENTO_CRECIMIENTO=2.0

# Shop base prices
BOX_PRECIO_MEJORA_ENTRENAMIENTO=1000
BOX_PRECIO_MEJORA_TRABAJO=1000
BOX_PRECIO_TRATAMIENTO_FISIOTERAPEUTICO=10000
BOX_PRECIO_TRATAMIENTO_CINCO_ESTRELLAS=50000
BOX_PRECIO_SUMINISTRO_VIDA=1500
BOX_PRECIO_SUMINISTRO_CANSANCIO=1500
BOX_PRECIO_SUMINISTRO_DEFENSA=3000
BOX_PRECIO_SUMINISTRO_LESION=60000
BOX_PRECIO_EQUIPAMIENTO_CASCO=1000
BOX_PRECIO_EQUIPAMIENTO_GUANTES=1000
BOX_PRECIO_EQUIPAMIENTO_PROTECTOR_BUCAL=600
BOX_PRECIO_EQUIPAMIENTO_SHORT=600
BOX_PRECIO_EQUIPAMIENTO_BOTAS=800

# Injuries: duration in hours, probability gain per action hour,
# probability cap, decay per idle hour (percentage points)
BOX_LESION_HORAS=3
BOX_LESION_PROBABILIDAD_POR_HORA=1.0
BOX_LESION_PROBABILIDAD_MAXIMA=100
BOX_LESION_DECAIMIENTO_POR_HORA=0.01

# Challenges: window to accept (hours) and fight duration (hours) - decimals allowed
# plus winner EXP multiplier and fixed skill points per upgrade used
BOX_DESAFIO_VENTANA_HORAS=1
BOX_DESAFIO_DURACION_HORAS=24
BOX_DESAFIO_EXP_SPARRING=5
BOX_DESAFIO_EXP_PELEA=10
BOX_DESAFIO_RECOMPENSA_POR_MEJORA=5

# Sponsor chance curve while promoting: hours=percent points,
# linearly interpolated (comma-separated)
BOX_PROMOCION_PROBABILIDAD=1=5,2=10,4=20,8=40,12=60,16=80,24=100

# Sponsors: draw chance per type (%), duration in days, payment per
# cycle, max simultaneous units. Maps use clave=valor,clave=valor.
BOX_SPONSOR_PROBABILIDAD=redes=50,radio=30,equipamiento=15,medico=5
BOX_SPONSOR_DURACION_DIAS=redes=7,radio=7,equipamiento=14,medico=30
BOX_SPONSOR_PAGO=redes=500,radio=1000
BOX_SPONSOR_MAXIMO=redes=10,radio=10

# Payment cycle of Redes/Radio and treatment cycle of Medico, in hours
BOX_SPONSOR_CICLO_PAGO_HORAS=24
BOX_MEDICO_CICLO_HORAS=24

# EXP bonus per active Equipamiento sponsor (%), and injury
# probability reduction per Medico treatment (%)
BOX_SPONSOR_EQUIPAMIENTO_BONUS=10
BOX_MEDICO_REDUCCION=50

# Starting combat stats of a new boxer
BOX_VIDA_INICIAL=32
BOX_CANSANCIO_INICIAL=25
BOX_DANO_INICIAL=1
BOX_DANO_MAXIMO=25
BOX_DEFENSA_INICIAL=1
BOX_DEFENSA_MAXIMO=22
