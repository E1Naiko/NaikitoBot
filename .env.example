# Required
DISCORD_TOKEN=replace_with_your_bot_token
ADMIN_USER_IDS=123456789012345678
GUILD_ID=123456789012345678
GENERAL_CHANNEL_ID=123456789012345678
MADRUGUE_CHANNEL_ID=123456789012345678

# Channels: comma-separated Discord channel IDs
BOX_CHANNEL_ID=123456789012345678
SSF_CANALES_ID=123456789012345678
LAHORA_CANALES_ID=123456789012345678

# Runtime and database
TIMEZONE=America/Argentina/Buenos_Aires

# Capa de datos (SQLAlchemy asíncrono). Si definís DATABASE_URL el bot la usa
# tal cual; si no, cae a SQLite sobre el archivo de DATABASE.
#   Producción (PostgreSQL + asyncpg):
# DATABASE_URL=postgresql+asyncpg://usuario:clave@host:5432/naikito
#   Desarrollo/pruebas (SQLite, por defecto):
# DATABASE_URL=sqlite+aiosqlite:///naikito.db
DATABASE=naikito.db

# SeptSinFP dates
SSF_FECHA_INICIO=2026-09-01
SSF_FECHA_FIN=2026-09-30

# Madrugue scoring: HH:MM windows, integer points, decimal bonus
MADRUGUE_INICIO_100=05:30
MADRUGUE_INICIO_25=07:00
MADRUGUE_INICIO_5=09:00
MADRUGUE_FIN=10:00
MADRUGUE_PUNTOS_100=100
MADRUGUE_PUNTOS_25=25
MADRUGUE_PUNTOS_5=5
MADRUGUE_BONUS_MAXIMO=0.100
MADRUGUE_BONUS_MINIMO=0.001

# 420 (canal LAHORA_CANALES_ID): escribir "420" dentro de una ventana suma
# puntos. Cada ventana abre en una hora de LAHORA_HORAS (HH:MM separadas por
# comas) y dura LAHORA_DURACION_MINUTOS (1 = solo el minuto 04:20 / 16:20).
# Puntos = LAHORA_PUNTOS_BASE x multiplicador de velocidad (de 1 +
# LAHORA_BONUS_VELOCIDAD al abrir hasta 1 al cerrar) + LAHORA_BONUS_PRIMERO
# para el primero de cada ventana.
LAHORA_HORAS=04:20,16:20
LAHORA_DURACION_MINUTOS=1
LAHORA_PUNTOS_BASE=10
LAHORA_BONUS_VELOCIDAD=0.5
LAHORA_BONUS_PRIMERO=5

# ============================================================
# BOX
# ============================================================

# Rewards per minute of each action
BOX_EXPERIENCIA_POR_MINUTO=10
BOX_DINERO_POR_MINUTO=100

# Action duration limits, in minutes
BOX_MINUTOS_MINIMO=1
BOX_MINUTOS_MAXIMO=1440

# Fixed gain per level of each upgrade (Creatina / Cafe)
BOX_MEJORA_ENTRENAMIENTO_EXP_POR_NIVEL=5
BOX_MEJORA_TRABAJO_DINERO_POR_NIVEL=50
BOX_MEJORA_NIVEL_MAXIMO=10

# Shop: global price multiplier (applies to every item) and
# per-level growth (upgrades compound, equipment multiplies)
BOX_PRECIO_MULTIPLICADOR=1.0
BOX_PRECIO_MEJORA_CRECIMIENTO=1.25
BOX_PRECIO_EQUIPAMIENTO_CRECIMIENTO=2.0

# Shop base prices
BOX_PRECIO_MEJORA_ENTRENAMIENTO=1000
BOX_PRECIO_MEJORA_TRABAJO=1000
BOX_PRECIO_TRATAMIENTO_FISIOTERAPEUTICO=10000
BOX_PRECIO_TRATAMIENTO_CINCO_ESTRELLAS=50000
BOX_PRECIO_SUMINISTRO_VIDA=1500
BOX_PRECIO_SUMINISTRO_CANSANCIO=1500
BOX_PRECIO_SUMINISTRO_DEFENSA=3000
BOX_PRECIO_SUMINISTRO_LESION=60000
BOX_PRECIO_EQUIPAMIENTO_CASCO=1000
BOX_PRECIO_EQUIPAMIENTO_GUANTES=1000
BOX_PRECIO_EQUIPAMIENTO_PROTECTOR_BUCAL=600
BOX_PRECIO_EQUIPAMIENTO_SHORT=600
BOX_PRECIO_EQUIPAMIENTO_BOTAS=800

# Injuries: duration in hours, probability gain per action hour,
# probability cap, passive decay per idle hour, and active reduction per
# completed rest hour (all rates are percentage points)
BOX_LESION_HORAS=3
BOX_LESION_PROBABILIDAD_POR_HORA=1.0
BOX_LESION_PROBABILIDAD_MAXIMA=100
BOX_LESION_DECAIMIENTO_POR_HORA=0.01
BOX_DESCANSO_REDUCCION_POR_HORA=1.0

# Challenges: window to accept (hours) and fight duration (hours) - decimals allowed
# plus winner EXP multiplier and fixed skill points per upgrade used.
# PREMIO_VS_BOT is the fraction of the money prize a human collects for
# beating the bot in a fight (fighting the house pays less than fighting
# another player); EXP is paid in full either way
BOX_DESAFIO_VENTANA_HORAS=1
BOX_DESAFIO_DURACION_HORAS=24
BOX_DESAFIO_EXP_SPARRING=5
BOX_DESAFIO_EXP_PELEA=10
BOX_DESAFIO_RECOMPENSA_POR_MEJORA=5
BOX_DESAFIO_PREMIO_VS_BOT=0.25

# Live narration of fights and sparring. The combat is planned when the
# challenge is accepted; each round is one channel message and each tick
# reveals one more line, so the real fight lasts
# rounds * (dialogues + 1) * tick seconds while BOX_DESAFIO_DURACION_HORAS
# keeps locking the action.
BOX_COMBATE_ACTIVO=1
BOX_COMBATE_TICK_SEGUNDOS=15
BOX_COMBATE_DIALOGOS_POR_ROUND=7
BOX_COMBATE_ROUNDS_MINIMO=3
BOX_COMBATE_ROUNDS_MAXIMO=9
# One fight at a time: while a round is being narrated, the next challenge is
# refused (the box channel is single-track). 0 scopes the lock per server
BOX_COMBATE_UNICO_GLOBAL=1
# Share of exchanges that score for nobody (tactical commentary)
BOX_COMBATE_NEUTRALES=0.35
# Win probability of the favorite, compressed and clamped (log EXP scale).
# The formula never moves more than COMPRESION from 50%, so these two only
# bind on hopeless mismatches
BOX_COMBATE_PROB_PISO=0.10
BOX_COMBATE_PROB_TOPE=0.90
BOX_COMBATE_SUELO_EXP=5000
BOX_COMBATE_COMPRESION=0.45
# Damage per exchange is vida_maxima / (rounds * this): lower empties the
# health bar sooner, higher makes every fight go the distance
BOX_COMBATE_ESCALA_DANO=2.8
# Early stoppage chance once somebody is 2+ rounds ahead: base + slope*gap
BOX_COMBATE_KO_BASE=0.025
BOX_COMBATE_KO_POR_BRECHA=0.07
BOX_COMBATE_KO_DESDE_ASALTO=3
# Equipment now feeds the simulation: each gear level adds this fraction to
# the stat the item owns (gloves=damage, headgear=defence, mouthguard=hp,
# shorts=defence, boots=less fatigue), and FUERZA is how much the whole kit
# weighs in the win chance (it tilts even fights, never a 10x EXP gap)
BOX_COMBATE_EQUIPO_ACTIVO=1
BOX_COMBATE_EQUIPO_POR_NIVEL=0.03
BOX_COMBATE_EQUIPO_FUERZA=0.01
# Guards for the tick: fights narrated per tick, sealed rounds per tick
BOX_COMBATE_MAX_POR_TICK=6
BOX_COMBATE_MAX_ASELLAR_POR_TICK=3
# Default for the crowd chant, which names a real member. The server decides
# with /admin box canticos; until then this value rules, and it is off

# Sponsor chance curve while promoting: hours=percent points,
# linearly interpolated (comma-separated)
BOX_PROMOCION_PROBABILIDAD=1=5,2=10,4=20,8=40,12=60,16=80,24=100

# Sponsors: draw chance per type (%), duration in days, payment per
# cycle, max simultaneous units. Maps use clave=valor,clave=valor.
BOX_SPONSOR_PROBABILIDAD=redes=50,radio=30,equipamiento=15,medico=5
BOX_SPONSOR_DURACION_DIAS=redes=7,radio=7,equipamiento=14,medico=30
BOX_SPONSOR_PAGO=redes=500,radio=1000
BOX_SPONSOR_MAXIMO=redes=10,radio=10

# Payment cycle of Redes/Radio and treatment cycle of Medico, in hours
BOX_SPONSOR_CICLO_PAGO_HORAS=24
BOX_MEDICO_CICLO_HORAS=24

# EXP bonus per active Equipamiento sponsor (%), and injury
# probability reduction per Medico treatment (%)
BOX_SPONSOR_EQUIPAMIENTO_BONUS=10
BOX_MEDICO_REDUCCION=50

# Starting combat stats of a new boxer
BOX_VIDA_INICIAL=32
BOX_CANSANCIO_INICIAL=25
BOX_DANO_INICIAL=1
BOX_DANO_MAXIMO=25
BOX_DEFENSA_INICIAL=1
BOX_DEFENSA_MAXIMO=22

# Puntuacion para decir la hora:
HORA_420_TARDE = time(16,20)
HORA_420_MADRUGADA = time(4,20)
VENTANA_420_SEGUNDOS = 60  # cuantos segundos alrededor de 4:20/16:20 valen
PUNTOS_420_EXACTO = 1  # puntos si escribes exactamente en el minuto